# Wildlife source and review revisions use byte-exact SHA-256 identities.
# Preserve their bytes across Windows, Linux and macOS checkouts.
art-source/wildlife-v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
public/demos/wildlife-v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Spatial workflow shell launchers and frozen evidence preserve cross-platform bytes.
scripts/spatial-assets/*.sh text eol=lf
docs/tactical/071-spatial-assets/**/*.json -text
docs/tactical/072-conditioning-fidelity/**/*.json -text

# Retained vehicle scenes, exports, textures and receipts are byte-exact captures.
art-source/vehicle-models/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
public/assets/models/vehicles/** -text
# These replay inputs are pinned by the retained bundle catalog.
scripts/authored-assets/compact-final-setup.json -text
scripts/authored-assets/compact-variant-template.json -text
scripts/authored-assets/ambulance-family.json -text
# Constructor hashes in the ambulance capture receipt use LF source bytes.
scripts/authored-assets/author_ambulance.py text eol=lf
scripts/authored-assets/build_ambulance.py text eol=lf
