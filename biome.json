{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!dist",
      "!art-source",
      "!public/demos",
      "!src/rendering/dump-truck-v2-fallback.json",
      "!test-results",
      "!ME complete tileset.tsx",
      "!docs/tactical/053-semantic-tileset-map/source-files.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["public/data/workshop-manifest.json"],
      "files": {
        "maxSize": 2097152
      }
    },
    {
      "includes": [
        "scripts/vehicle-riders/**/*.json",
        "scripts/vehicle-bake/family-rider-*.json",
        "scripts/vehicle-bake/beetle/*.json",
        "public/assets/models/trains/review/**/*.json",
        "src/wildlife/reviews.json",
        "src/wildlife/behavior-art.json",
        "src/wildlife/meadow-art.json",
        "src/traffic/vehicle-paints-v1.json"
      ],
      "files": {
        "maxSize": 33554432
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "public/data/art-catalog.json",
        "public/data/workshop-manifest.json",
        "public/data/outdoor-catalog.json",
        "public/data/family-sheets.json",
        "docs/tactical/071-spatial-assets/**/*.json",
        "docs/tactical/071-spatial-assets/**/*.html",
        "docs/tactical/072-conditioning-fidelity/**/*.json",
        "docs/tactical/072-conditioning-fidelity/**/*.html",
        "docs/tactical/073-spatial-alternatives/**/*.json",
        "docs/tactical/073-spatial-alternatives/**/*.html",
        "docs/tactical/074-alpha-geometry/**/*.json",
        "docs/tactical/074-alpha-geometry/**/*.html",
        "docs/tactical/075-alpha-guard-framing/**/*.json",
        "docs/tactical/075-alpha-guard-framing/**/*.html",
        "docs/tactical/053-semantic-tileset-map/source-manifest.json",
        "docs/tactical/053-semantic-tileset-map/semantic-model.json",
        "docs/tactical/053-semantic-tileset-map/coverage-ledger.json",
        "docs/tactical/053-semantic-tileset-map/packets/*.json",
        "src/assets/outdoor/outdoor-runtime-v1.json",
        "src/art/city-review-snapshots-v1.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["docs/benchmarks/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/shared/**", "!src/shared/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/audio/**",
                      "**/client/**",
                      "**/console/**",
                      "**/explorer/**",
                      "**/input/**",
                      "**/rendering/**",
                      "**/scenarios/**",
                      "**/scenes/**",
                      "**/server/**",
                      "**/ui/**",
                      "**/workshop/**",
                      "**/xr/**",
                      "**/boats/**",
                      "**/characters/**",
                      "**/editor/**",
                      "**/interiors/**",
                      "**/patterns/**",
                      "**/railway/**",
                      "**/rooms/**",
                      "**/traffic/**",
                      "**/wildlife/**",
                      "!../characters/PlayerModels.js",
                      "!../editor/EditorTypes.js",
                      "!../railway/CurveTrain.js",
                      "!../railway/RailPath.js",
                      "!../traffic/Vehicle.js",
                      "!../traffic/VehiclePaint.js"
                    ],
                    "message": "shared/ is the protocol and utility layer; it must not depend on hosts, presentation or feature directories."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/autotile/**",
        "src/boats/**",
        "src/characters/**",
        "src/entities/**",
        "src/game/**",
        "src/generation/**",
        "src/interiors/**",
        "src/patterns/**",
        "src/persistence/**",
        "src/physics/**",
        "src/railway/**",
        "src/road/**",
        "src/scripting/**",
        "src/server/**",
        "src/traffic/**",
        "src/wildlife/**",
        "src/world/**",
        "src/config/**",
        "src/mods/**",
        "src/projection/**",
        "src/rooms/**",
        "src/scenarios/**",
        "src/transport/**",
        "!**/*.test.ts",
        "!src/characters/CharacterTestScene.ts",
        "!src/interiors/playtest/**",
        "!src/interiors/review/**",
        "!src/interiors/workbench/**",
        "!src/interiors/AdvancedSuite.ts",
        "!src/interiors/ApartmentFloorPlan.ts",
        "!src/interiors/CachedInteriorRenderer.ts",
        "!src/interiors/ConnectedRoomGrammar.ts",
        "!src/interiors/FurnishedInterior.ts",
        "!src/interiors/FurnitureMotion.ts",
        "!src/interiors/GenericHomeGeometry.ts",
        "!src/interiors/InteriorPresentation.ts",
        "!src/interiors/presentInterior.ts",
        "!src/patterns/PatternRuntime.ts",
        "!src/server/testing/**",
        "!src/server/*Annotations.ts",
        "!src/server/workshop*.ts",
        "!src/scenarios/ScenarioPresentationHost.ts",
        "!src/scenarios/ScenarioReplica.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/client/**",
                      "**/rendering/**",
                      "**/scenes/**",
                      "**/ui/**",
                      "**/workshop/**"
                    ],
                    "message": "Worker authority and simulation code must not depend on client, rendering, UI or Workshop modules."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/interiors/ApartmentFloorPlan.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/client/**",
                      "**/rendering/**",
                      "**/scenes/**",
                      "**/ui/**",
                      "**/workshop/**",
                      "!../rendering/CanvasInteriorMap.js"
                    ],
                    "message": "Worker authority and simulation code must not depend on client, rendering, UI or Workshop modules."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
