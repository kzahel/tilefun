{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!test-results",
      "!ME complete tileset.tsx",
      "!public/demos/vehicle-bake/viewer.js",
      "!public/demos/vehicle-bake/**/raw-viewer.js",
      "!public/demos/vehicle-bake/**/offline-raw.html",
      "!public/demos/original-vehicles/**/viewer.js",
      "!public/demos/vehicle-riders/**/viewer.js",
      "!public/demos/vehicle-riders/**/offline.html",
      "!art-source/vehicle-bake/**/scripts/capture.mjs",
      "!art-source/vehicle-bake/**/recipe-scripts/capture.mjs",
      "!art-source/vehicle-riders/classic-comparison/v1/helpers/peer-eye-probe.mjs",
      "!art-source/vehicle-riders/**/viewer.js",
      "!art-source/vehicle-riders/**/offline.html",
      "!art-source/wildlife-v2/cat/motion-v2/projection.json",
      "!art-source/wildlife-v2/dog/motion-v2/projection.json",
      "!art-source/wildlife-v2/centipede/roster-v3/projection.json",
      "!art-source/wildlife-v2/millipede/roster-v3/projection.json",
      "!docs/tactical/053-semantic-tileset-map/source-files.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "public/demos/wildlife-v2/horse/motion-study-v1/playback.js",
        "public/demos/wildlife-v2/horse/motion-study-v2/playback.js",
        "public/demos/wildlife-v2/horse/motion-study-v1/index.html",
        "public/demos/wildlife-v2/horse/motion-study-v2/index.html",
        "public/demos/original-vehicles/explorer-boat-v1/index.html",
        "art-source/vehicle-bake/food-truck/v1/independent-visual.mjs"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off"
          }
        }
      }
    },
    {
      "includes": ["public/data/workshop-manifest.json"],
      "files": {
        "maxSize": 2097152
      }
    },
    {
      "includes": [
        "art-source/wildlife-v2/**/*.json",
        "art-source/vehicle-models/**/*.json",
        "art-source/train-models/**/*.json",
        "art-source/vehicle-style-study/**/*.json",
        "art-source/vehicle-bake/**/*.json",
        "art-source/vehicle-riders/**/*.json",
        "scripts/vehicle-riders/**/*.json",
        "scripts/vehicle-bake/family-rider-*.json",
        "scripts/vehicle-bake/beetle/*.json",
        "public/assets/models/trains/review/**/*.json",
        "public/demos/wildlife-v2/**/*.json",
        "public/demos/vehicle-style-study/**/*.json",
        "public/demos/vehicle-bake/**/*.json",
        "public/demos/original-vehicles/**/*.json",
        "public/demos/vehicle-riders/**/*.json",
        "src/wildlife/reviews.json"
      ],
      "files": {
        "maxSize": 33554432
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "public/data/art-catalog.json",
        "public/data/workshop-manifest.json",
        "public/data/outdoor-catalog.json",
        "public/data/family-sheets.json",
        "docs/tactical/071-spatial-assets/**/*.json",
        "docs/tactical/071-spatial-assets/**/*.html",
        "docs/tactical/072-conditioning-fidelity/**/*.json",
        "docs/tactical/072-conditioning-fidelity/**/*.html",
        "docs/tactical/073-spatial-alternatives/**/*.json",
        "docs/tactical/073-spatial-alternatives/**/*.html",
        "docs/tactical/074-alpha-geometry/**/*.json",
        "docs/tactical/074-alpha-geometry/**/*.html",
        "docs/tactical/075-alpha-guard-framing/**/*.json",
        "docs/tactical/075-alpha-guard-framing/**/*.html",
        "docs/tactical/053-semantic-tileset-map/source-manifest.json",
        "docs/tactical/053-semantic-tileset-map/semantic-model.json",
        "docs/tactical/053-semantic-tileset-map/coverage-ledger.json",
        "docs/tactical/053-semantic-tileset-map/packets/*.json",
        "src/assets/outdoor/outdoor-runtime-v1.json",
        "src/art/city-review-snapshots-v1.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["demo/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "art-source/wildlife-v2/panther/hunt-v1/playback.js",
        "public/demos/wildlife-v2/panther/hunt-v1/playback.js"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
