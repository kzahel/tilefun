{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!test-results",
      "!ME complete tileset.tsx",
      "!docs/tactical/053-semantic-tileset-map/source-files.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "public/data/art-catalog.json",
        "public/data/workshop-manifest.json",
        "public/data/outdoor-catalog.json",
        "docs/tactical/053-semantic-tileset-map/source-manifest.json",
        "docs/tactical/053-semantic-tileset-map/packets/*.json",
        "src/assets/outdoor/outdoor-runtime-v1.json",
        "src/art/city-review-snapshots-v1.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["demo/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
