{
  "name": "tilefun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check:worker": "npm run test:worker && npm --prefix worker run build:check",
    "dev": "vite",
    "build": "tsx scripts/build-review-sprites.ts --check && tsx scripts/build-gameplay-furniture.ts --check && tsx scripts/build-art-catalog.ts --check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots:interiors": "npm run build && playwright test tests/interiors-screenshots.spec.ts",
    "assets:interiors": "node scripts/index-interiors-atlas.mjs",
    "assets:review": "tsx scripts/build-review-sprites.ts",
    "interiors:counterexamples": "tsx scripts/interior-counterexamples.ts",
    "explorer:bench": "tsx scripts/benchmark-regional.ts",
    "dev:server": "tsx --watch src/server/standalone.ts",
    "start:server": "tsx src/server/standalone.ts",
    "generation:bench": "tsx scripts/benchmark-generation.ts",
    "art:catalog": "tsx scripts/build-art-catalog.ts",
    "art:notes": "tsx scripts/art-notes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
